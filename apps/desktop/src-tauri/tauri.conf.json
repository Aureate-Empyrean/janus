{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Janus",
  "version": "0.1.0",
  "identifier": "org.aureate-empyrean.janus",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Janus — development build",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 540,
        "backgroundColor": "#090a0c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Aureate Empyrean contributors",
    "copyright": "AGPL-3.0-or-later",
    "shortDescription": "Local-first encrypted vault (development build)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
